$wb['top_menu_customizer'] = 'Branding';
$wb['White-label'] = 'White-label';
$wb['Branding'] = 'Branding';
// resolved via $app->lng() in customizer_edit.php (the module lng is auto-loaded there)
$wb['no_logo_set_txt'] = 'No custom logo set — the theme shows its own default.';
// Shown under a logo preview that is displaying the OTHER variant because its
// own slot is empty. They live in THIS wordbook, not the tform one, for the same
// reason as no_logo_set_txt: logo_upload.php renders the very same previews and
// has no tform at all, so it resolves them through $app->lng().
$wb['logo_fallback_from_dark_txt'] = 'No light-background logo set, so the dark-background one is shown here — that is what a light design will display. Upload a dark or full-colour mark to change it.';
$wb['logo_fallback_from_light_txt'] = 'No dark-background logo set, so the light-background one is shown here — that is what a dark design will display. Upload a light or white mark to change it.';
// Captions under the logo preview swatches, naming the panel surface each
// swatch stands for. Deliberately SHORT — they sit beneath a thumbnail, not
// beside a form field, so they name the surface rather than restating the
// setting (the fuller wording is logo_variant_nav_txt / logo_variant_login_txt
// in the tform wordbook). Same wordbook reason as the two keys above:
// logo_upload.php redraws these previews and has no tform.
$wb['surface_nav_txt'] = 'Navigation';
$wb['surface_login_txt'] = 'Login screen';
$wb['no_favicon_set_txt'] = 'No custom favicon set — the design shows its own.';
$wb['favicon_url_wins_txt'] = 'This is the favicon path set below, which wins over the uploaded file — that is the same rule the logo paths follow. Clear the path and press Save to use the uploaded icon instead.';
// The three status facts in the Branding page's legend, under the proof. They
// live in THIS wordbook rather than the tform one for the same reason
// no_logo_set_txt does: customizer/preview.php rebuilds them after every
// keystroke and has no tform at all, so it resolves them through $app->lng().
// %s and %d are filled with str_replace(), never sprintf() — a translation
// carrying a stray '%' would make sprintf() raise a ValueError, which on an
// admin page is a fatal raised by a wordbook file.
$wb['summary_design_txt'] = '%s active';
$wb['summary_marks_none_txt'] = 'No marks';
$wb['summary_marks_one_txt'] = '%d mark';
$wb['summary_marks_txt'] = '%d marks';
$wb['summary_favicon_txt'] = 'Favicon set';
$wb['summary_favicon_none_txt'] = 'No favicon';
