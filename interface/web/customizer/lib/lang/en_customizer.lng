$wb['customizer_title'] = 'Branding';
$wb['page_head_txt'] = 'Customizer';
$wb['customizer_desc_txt'] = 'Brand this control panel as your own — the logo, name and colours are stored in ISPConfig and survive panel and theme updates.';
$wb['settings_saved_txt'] = 'Settings saved. Colour changes appear after a full page refresh (F5).';

$wb['logo_head_txt'] = 'Logo';
// The two logo slots are named after the BACKGROUND they sit on, not after the
// colour of the artwork: which of your designs has a dark header is something
// you can look at, whereas "is this artwork light enough" is a judgement call.
$wb['logo_variants_hint_txt'] = 'Two slots, because designs disagree about brightness: clarity puts the logo on a dark navy rail, the stock look puts it on a light grey header. Fill in the slot that matches the design you use. Leave the other empty and it simply borrows this one, exactly as the panel behaves today. Each preview is drawn on the background its slot is for, so a mark in the wrong slot is obvious at a glance.';

$wb['logo_on_light_head_txt'] = 'Logo for light backgrounds';
$wb['logo_txt'] = 'Logo file';
$wb['logo_hint_txt'] = 'The mark that sits ON a light background, so it should be dark or full-colour. This is the one ISPConfig itself uses: the stock header and the login page are both light. Choose a file, then click "Upload logo" — the logo uploads on its own, separately from the Save button at the bottom. SVG, PNG, JPEG, GIF or WebP, under 45 KB.';
$wb['upload_txt'] = 'Upload logo';
$wb['logo_url_txt'] = 'Light-background logo path / URL (override)';
$wb['logo_url_hint_txt'] = 'Optional, and it wins over the uploaded file above. A root-relative path (recommended — e.g. /themes/custom/logo.svg for a file you placed on the server) or an https:// URL. When set, brand-aware designs use it everywhere, including their login screen; only the stock ISPConfig theme always uses the uploaded one, because the upload is the only value core knows about. SVG or a 2x PNG around 500&times;160 works best (it displays about 26px tall). A remote URL ties your login page to that host and reveals visitor IPs to it — prefer a local path.';
$wb['logo_url_error_regex'] = 'The light-background logo path must be a root-relative path (/…) or an https:// URL, without spaces, quotes, brackets or parentheses.';

$wb['logo_on_dark_head_txt'] = 'Logo for dark backgrounds';
$wb['logo_on_dark_txt'] = 'Logo file';
$wb['logo_on_dark_hint_txt'] = 'The mark that sits ON a dark background, so it should be light or white. Clarity’s navy sidebar and login band use this one. Same formats and the same 45 KB limit. Worth knowing: ISPConfig has only one logo column and this extension adds none, so this image is kept in the interface settings instead — which means it is re-read on page loads and is written into the change log the next time you press Save. If that matters on your panel, use the path field below instead; a path costs a few bytes.';
$wb['used_logo_on_dark_txt'] = 'Current logo';
$wb['logo_url_on_dark_txt'] = 'Dark-background logo path / URL (override)';
$wb['logo_url_on_dark_hint_txt'] = 'Optional, and it wins over the uploaded file above. Same rules as the light-background path: a root-relative path (recommended) or an https:// URL. This is also how you keep a dark-background logo out of the interface settings entirely — a path is a few bytes where an uploaded image is up to 60 KB.';
$wb['logo_url_on_dark_error_regex'] = 'The dark-background logo path must be a root-relative path (/…) or an https:// URL, without spaces, quotes, brackets or parentheses.';

$wb['logo_remove_txt'] = 'Remove';
$wb['used_logo_txt'] = 'Current logo';
// no_logo_set_txt and the two logo_fallback_* notes are resolved via $app->lng(),
// which reads lib/lang/en.lng — logo_upload.php renders the same previews and has
// no tform at all, so they cannot live in this file (which feeds the tform
// wordbook only). A copy here would be dead.

// Which of the two slots above each SURFACE uses. Scoped by surface rather than
// by design, because the sidebar and login-background colours let the operator
// recolour the very backgrounds the designs used to assume — a white sidebar
// colour painted the white mark onto a white rail. Automatic reads that colour
// and decides; the two explicit values are the escape hatch for surfaces whose
// real backdrop is not the colour you set (the stock login mark sits inside
// Bootstrap's own white panel heading, which the login background never reaches).
// TRANSLATORS: the three option labels below are resolved through the tform
// wordbook, not $app->lng() — tform_base.inc.php:505 swaps a SELECT option label
// for its translation only when the label string is a key in this file. Two
// consequences: the value is emitted into the <option> UNESCAPED, so keep markup
// out of it, and it must never be empty — select2 treats a first option with an
// empty value AND an empty label as a placeholder and drops "Automatic" out of
// the list entirely, which lang_check.php cannot catch because it compares key
// sets and never looks at a value.
$wb['logo_variant_nav_txt'] = 'Logo on the navigation bar';
$wb['logo_variant_nav_hint_txt'] = 'Which of the two marks above the sidebar and the header use. Automatic reads the sidebar colour you set below and picks the mark that stays readable on it; with no colour set, each design keeps its own — the stock look draws the logo on a light grey header, Clarity on a dark navy rail. Change this only if you have set a colour that makes the automatic choice wrong, such as a white sidebar, where the mark for dark backgrounds would disappear. Either way a slot you have not filled still borrows from the other one, so a single logo keeps working.';
$wb['logo_variant_login_txt'] = 'Logo on the login screen';
$wb['logo_variant_login_hint_txt'] = 'The same choice for the login page. Automatic reads the login background colour you set below and picks the mark that stays readable on it. Left on Automatic with no login background set, Clarity follows the viewer’s own light/dark mode — the mark for light backgrounds in light mode, the mark for dark backgrounds in dark mode — while the stock look keeps its light login card. Change this only if the colour you chose makes the automatic choice wrong; an unfilled slot still borrows from the other one.';
$wb['logo_variant_auto_txt'] = 'Automatic — match the background';
$wb['logo_variant_on_light_txt'] = 'Always the mark for light backgrounds';
$wb['logo_variant_on_dark_txt'] = 'Always the mark for dark backgrounds';
$wb['logo_variant_nav_error_regex'] = 'The navigation bar logo choice must be Automatic, the mark for light backgrounds, or the mark for dark backgrounds.';
$wb['logo_variant_login_error_regex'] = 'The login screen logo choice must be Automatic, the mark for light backgrounds, or the mark for dark backgrounds.';

// The favicon: one slot, not two. A tab strip is a tab strip whatever the
// design's header looks like, so the light/dark model above does not apply.
$wb['favicon_head_txt'] = 'Favicon';
$wb['favicon_intro_txt'] = 'The small icon in the browser tab, in bookmarks and in history. Every design ships its own, so an otherwise fully branded panel still shows someone else’s mark there — this replaces it on every page, including the login screen. One icon for the whole panel: unlike the logo there is no light/dark pair, because a browser draws the same icon whatever the design’s header looks like.';
$wb['favicon_txt'] = 'Favicon file';
$wb['favicon_hint_txt'] = 'SVG (plain, script-free), PNG or ICO, under 15 KB. Choose a file, then click “Upload favicon” — it uploads on its own, separately from the Save button at the bottom. An SVG scales to every screen density; a .ico still covers browsers that will not take one, and a plain 32&times;32 PNG is fine by itself. Whatever you choose, look at the 16px preview above: fine detail and small lettering turn to mud at that size, and a tab is the smallest place your brand ever appears.';
$wb['favicon_upload_txt'] = 'Upload favicon';
$wb['used_favicon_txt'] = 'Current favicon';
$wb['favicon_url_txt'] = 'Favicon path / URL (override)';
$wb['favicon_url_hint_txt'] = 'Optional, and it wins over the uploaded file above — the same precedence the logo paths have. A root-relative path (recommended — e.g. /themes/custom/favicon.svg for a file you placed on the server) or an https:// URL. The panel sends the browser there instead of serving stored bytes, so this also keeps the icon out of the interface settings entirely. A remote URL ties every page of your panel to that host and reveals visitor IPs to it — prefer a local path.';
$wb['favicon_url_error_regex'] = 'The favicon path must be a root-relative path (/…) or an https:// URL, without spaces, quotes, brackets or parentheses.';

