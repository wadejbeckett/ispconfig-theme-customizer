$wb['favicon_head_txt'] = 'Favicon';
$wb['favicon_intro_txt'] = 'Het kleine pictogram in het browsertabblad, in bladwijzers en in de geschiedenis. Elk ontwerp levert er zelf een mee, dus een verder volledig gebrand panel toont daar nog steeds het merk van iemand anders — dit vervangt het op elke pagina, ook op het aanmeldscherm. Eén pictogram voor het hele panel: anders dan bij het logo is er geen licht/donker-paar, omdat de browser hetzelfde pictogram tekent, hoe de kopregel van het ontwerp er ook uitziet.';
$wb['favicon_txt'] = 'Favicon-bestand';
$wb['favicon_hint_txt'] = 'SVG (eenvoudig, zonder scripts), PNG of ICO, onder de 15 KB. Kies een bestand en klik daarna op “Favicon uploaden” — het wordt op zichzelf geüpload, los van de knop Opslaan onderaan. Een SVG schaalt naar elke schermdichtheid; een .ico dekt nog steeds browsers die er geen accepteren, en een eenvoudige 32&times;32-PNG volstaat op zichzelf. Wat u ook kiest: bekijk de voorbeeldweergave op 16px hierboven. Fijne details en kleine letters lopen op dat formaat dicht, en een tabblad is de kleinste plek waar uw merk ooit verschijnt.';
$wb['favicon_upload_txt'] = 'Favicon uploaden';
