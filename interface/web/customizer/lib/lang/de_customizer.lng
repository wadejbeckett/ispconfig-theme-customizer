$wb['logo_remove_txt'] = 'Entfernen';
$wb['used_logo_txt'] = 'Aktuelles Logo';
$wb['logo_variants_hint_txt'] = 'Zwei Felder, weil die Designs unterschiedlich hell sind: Clarity setzt das Logo auf eine dunkelblaue Leiste, die Standardansicht auf eine hellgraue Kopfzeile. Füllen Sie das Feld aus, das zu Ihrem Design passt. Lassen Sie das andere leer, übernimmt es einfach dieses hier — genau so, wie sich das Panel schon heute verhält. Jede Vorschau wird auf dem Hintergrund gezeigt, für den ihr Feld gedacht ist, sodass ein Logo im falschen Feld sofort auffällt.';
$wb['logo_on_light_head_txt'] = 'Logo für helle Hintergründe';
$wb['logo_on_dark_head_txt'] = 'Logo für dunkle Hintergründe';
$wb['logo_on_dark_txt'] = 'Logo-Datei';
$wb['logo_on_dark_hint_txt'] = 'Das Logo, das AUF einem dunklen Hintergrund sitzt und daher hell oder weiß sein sollte. Die dunkelblaue Seitenleiste und der Anmeldebereich von Clarity verwenden dieses. Gleiche Formate, gleiche Grenze von 45 KB. Wichtig zu wissen: ISPConfig hat nur eine Logo-Spalte und diese Erweiterung legt keine weitere an, deshalb wird dieses Bild in den Interface-Einstellungen abgelegt — es wird also bei Seitenaufrufen erneut gelesen und beim nächsten Speichern in das Änderungsprotokoll geschrieben. Falls das auf Ihrem Panel eine Rolle spielt, verwenden Sie stattdessen das Pfadfeld unten; ein Pfad kostet nur wenige Bytes.';
$wb['used_logo_on_dark_txt'] = 'Aktuelles Logo';
