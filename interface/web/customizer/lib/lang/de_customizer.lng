$wb['favicon_head_txt'] = 'Favicon';
$wb['favicon_intro_txt'] = 'Das kleine Symbol im Browser-Tab, in den Lesezeichen und im Verlauf. Jedes Design bringt sein eigenes mit, sodass ein ansonsten vollständig gebrandetes Panel dort weiterhin ein fremdes Zeichen zeigt — dieses Feld ersetzt es auf jeder Seite, auch auf der Anmeldeseite. Ein Symbol für das gesamte Panel: Anders als beim Logo gibt es kein helles/dunkles Paar, denn der Browser zeichnet dasselbe Symbol, unabhängig davon, wie die Kopfzeile des Designs aussieht.';
$wb['favicon_txt'] = 'Favicon-Datei';
$wb['favicon_hint_txt'] = 'SVG (unkompliziert, ohne Skripte), PNG oder ICO, unter 15 KB. Wählen Sie eine Datei und klicken Sie dann auf „Favicon hochladen" — es wird eigenständig hochgeladen, getrennt von der Schaltfläche „Speichern" unten. Ein SVG skaliert auf jede Bildschirmdichte; eine .ico deckt weiterhin Browser ab, die kein SVG annehmen, und ein einfaches 32&times;32-PNG genügt für sich allein. Was Sie auch wählen: Sehen Sie sich die 16-px-Vorschau oben an. Feine Details und kleine Schrift verschwimmen in dieser Größe, und ein Tab ist der kleinste Ort, an dem Ihre Marke je erscheint.';
$wb['favicon_upload_txt'] = 'Favicon hochladen';
$wb['used_favicon_txt'] = 'Aktuelles Favicon';
$wb['favicon_url_txt'] = 'Favicon-Pfad / -URL (Überschreibung)';
$wb['favicon_url_hint_txt'] = 'Optional; hat Vorrang vor der hochgeladenen Datei oben — dieselbe Rangfolge wie bei den Logo-Pfaden. Ein serverrelativer Pfad (empfohlen — z. B. /themes/custom/favicon.svg für eine Datei, die Sie auf dem Server abgelegt haben) oder eine https://-URL. Das Panel verweist den Browser dorthin, statt gespeicherte Bytes auszuliefern, und hält das Symbol damit vollständig aus den Interface-Einstellungen heraus. Eine externe URL bindet jede Seite Ihres Panels an diesen Host und gibt ihm die IP-Adressen Ihrer Besucher preis — ein lokaler Pfad ist vorzuziehen.';
$wb['favicon_url_error_regex'] = 'Der Favicon-Pfad muss ein serverrelativer Pfad (/…) oder eine https://-URL sein, ohne Leerzeichen, Anführungszeichen oder Klammern.';

